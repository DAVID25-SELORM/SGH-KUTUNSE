{
  "name": "satellite-general-hospital",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "stage:stormerhost": "node scripts/stage-stormerhost.mjs",
    "test:stormerhost": "node scripts/smoke-stormerhost.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --exclude tests/firestore-rules.test.ts",
